{
    "@context": "http://www.w3.org/ns/odrl.jsonld",
    "@type": "Set",
    "uid": "policy:torque-only-in-drive-or-reverse",
    "prohibition":
    [
        {
            "target": "urn:vehicle:requested-torque",
            "action": "increase",
            "constraint":
            [
                {
                    "leftOperand": "urn:vehicle:gear-mode",
                    "operator": "neq",
                    "rightOperand": "Drive"
                },
                {
                    "leftOperand": "urn:vehicle:gear-mode",
                    "operator": "neq",
                    "rightOperand": "Reverse"
                }
            ]
        }
    ]
}