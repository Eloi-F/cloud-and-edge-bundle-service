{
    "@context": "http://www.w3.org/ns/odrl.jsonld",
    "@type": "Set",
    "uid": "policy:torque-within-powertrain-limit",
    "prohibition":
    [
        {
            "target": "urn:vehicle:requested-torque",
            "action": "increase",
            "constraint":
            [
                {
                    "leftOperand": "urn:vehicle:requested-torque",
                    "operator": "gt",
                    "rightOperand":
                    {
                        "@value": "urn:vehicle:powertrain-max-torque"
                    }
                }
            ]
        }
    ]
}