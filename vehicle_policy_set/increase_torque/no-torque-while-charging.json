{
    "@context": "http://www.w3.org/ns/odrl.jsonld",
    "@type": "Set",
    "uid": "policy:no-torque-while-charging",
    "prohibition":
    [
        {
            "target": "urn:vehicle:requested-torque",
            "action": "increase",
            "constraint":
            [
                {
                    "leftOperand": "urn:vehicle:charging-connector-attached",
                    "operator": "eq",
                    "rightOperand": true
                }
            ]
        }
    ]
}