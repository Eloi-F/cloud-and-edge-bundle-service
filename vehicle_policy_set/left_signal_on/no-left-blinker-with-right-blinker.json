{
    "@context": "http://www.w3.org/ns/odrl.jsonld",
    "@type": "Set",
    "uid": "policy:no-left-blinker-with-right-blinker",
    "prohibition":
    [
        {
            "target": "urn:vehicle:left-blinker",
            "action": "activate",
            "constraint":
            [
                {
                    "leftOperand": "urn:vehicle:right-blinker-state",
                    "operator": "eq",
                    "rightOperand": true
                }
            ]
        }
    ]
}