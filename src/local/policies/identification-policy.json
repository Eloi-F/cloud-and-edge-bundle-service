{
    "@context": "./odrl-vocabulary.md",
    "@type": "Set",
    "uid": "urn:policy-id:services:request:identification",
    "duty":
    {
        "assignee": "urn:vehicle:controller",
        "action": "use",
        "target": "urn:services:identification",
        "constraint":
        [
            {
                "leftOperand": "urn:metric:latency",
                "operator": "lt",
                "rightOperand": 30,
                "comment": "QoS: maximum delay of 30ms."
            },
            {
                "leftOperand": "urn:metric:encryption",
                "operator": "eq",
                "rightOperand": true,
                "comment": "Nobody must see what the car sees."
            },
            {
                "leftOperand": "urn:metric:flow-rate",
                "operator": "gt",
                "rightOperand": 5,
                "comment": "The needed flow-rate should be at least 5Mb/s."
            }
        ]
    }
}