{
    "@context":"./odrl-vocabulary.md",
    "@type":"Set",
    "uid":"urn:policy-id:services:navigation",
    "duty": {
        "assignee":"urn:services:navigation",
        "target":"urn:host:cloud",
        "action":"urn:actions:associate-service-host",
        "comment":"Navigation service must be in the cloud",
        "constraint": [
            {
            "leftOperand":"urn:constraint:frequency",
            "operator":"gt",
            "rightOperand":"500",
            "comment":"Spamming shortest path API is forbidden."
            },
            {
            "leftOperand":"urn:constraint:encryption",
            "operator":"eq",
            "rightOperand":"true",
            "comment":"Nobody must see where the car is going."
            }
        ]
    }
}