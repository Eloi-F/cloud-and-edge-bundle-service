{
    "@context": "./src/odrl-vocabulary.md",
    "@type": "Set",
    "uid": "urn:policy-id:services:navigation-check-flow-rate",
    "duty":
    {
        "assignee": "urn:services:request:navigation",
        "target": "urn:host:cloud",
        "action": "urn:actions:verify-ressources-limit-allocation",
        "comment": "Request for navigation service should match bellow limitations.",
        "constraint":
        [
            {
                "leftOperand": "urn:constraint:flow-rate",
                "operator": "lt",
                "rightOperand": 25,
                "comment": "25Mb/s is sufficient for navigation service."
            }
        ]
    }
}