{
    "@context":"./src/odrl-vocabulary.md",
    "@type":"Set",
    "uid":"urn:policy-id:services:$SERVICE-check-latency",
    "duty": {
        "assignee":"urn:services:$SERVICE-request",
        "target":"urn:host:$HOST",
        "action":"urn:actions:verify-ressources-limit-allocation",
        "comment":"Request for $SERVICE service should match bellow limitations.",
        "constraint": [
            {
                "leftOperand":"urn:constraint:latency",
                "operator":"gt",
                "rightOperand":"XX",
                "comment":"Quickest $HOST server can deliver XXms latency."
            }
        ]
    }
}

